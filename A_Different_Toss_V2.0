import tkinter as tk
from tkinter import messagebox
import random

# Function to generate a random color in hexadecimal format
def get_random_color():
    return "#{:06x}".format(random.randint(0, 0xFFFFFF))

# Function to change background color based on selected theme
def change_background(theme):
    colors = {
        "Golden Grey": "#FFD700",  # Gold
        "Pink and Blue": "#FF69B4",  # Pink
        "Yellow": "#FFFF00",  # Yellow
        "White": "#FFFFFF",  # White
        "Grey": "#808080",  # Grey
    }
    root.configure(bg=colors[theme])
    title_label.configure(bg=colors[theme])
    input_frame.configure(bg=colors[theme])
    above_radio.configure(bg=colors[theme], selectcolor=colors[theme])
    below_radio.configure(bg=colors[theme], selectcolor=colors[theme])
    result_label.configure(bg=colors[theme])
    random_number_label.configure(bg=colors[theme])
    other_info_label.configure(bg=colors[theme])

# Function to perform the toss
def perform_toss():
    try:
        num = int(entry.get())
        if num <= 0:
            raise ValueError("Please enter a positive integer.")
    except ValueError as e:
        messagebox.showerror("Invalid Input", str(e))
        return
    
    if not selected_side.get():
        messagebox.showwarning("No Selection", "Please select a side: Above or Below.")
        return
    
    a = list(range(0, num))
    b = random.choice(a)
    half_num = num / 2

    # Determine win or lose
    result_text = ""
    user_won = False
    if b < half_num:
        result_text = f"{b} is BELOW half of {num} which is {half_num}."
        user_won = selected_side.get() == "Below"
    else:
        result_text = f"{b} is ABOVE half of {num} which is {half_num}."
        user_won = selected_side.get() == "Above"

    # Set the result label based on win or lose
    if user_won:
        result_label.config(text="You Won!", font=("Comic Sans MS", 28, "bold"), fg="green")
    else:
        result_label.config(text="You Lose", font=("Creepster", 28, "bold"), fg="red")
    
    # Display the random number with a different color each time
    random_number_label.config(text=f"The Randomly Selected Number is: {b}", 
                               font=("Helvetica", 24, "bold"), fg=get_random_color())
    
    # Display the detailed result
    other_info_label.config(text=f"\n{result_text}")

# Setting up the main window
root = tk.Tk()
root.title("A Different Toss")
root.geometry("600x550")

# Title Label with Theme Colors
title_label = tk.Label(root, text="⚔️xXx⚔️  🎲 A Different Toss 🎲 ⚔️xXx⚔️", 
                       font=("Helvetica", 18, "bold"), fg="#000000")
title_label.pack(pady=20)

# Input Frame with Themed Entry and Button
input_frame = tk.Frame(root, bg="#FFFFFF")
input_frame.pack(pady=10)

entry_label = tk.Label(input_frame, text="Enter number here:", font=("Helvetica", 12), fg="#000000", bg="#FFFFFF")
entry_label.grid(row=0, column=0, padx=10)

entry = tk.Entry(input_frame, font=("Helvetica", 12), bg="#1C1C1C", fg="#FFFFFF")
entry.grid(row=0, column=1)

# Radio buttons for Above or Below selection
selected_side = tk.StringVar()
above_radio = tk.Radiobutton(input_frame, text="Above", variable=selected_side, value="Above", 
                             font=("Helvetica", 12), fg="#000000", bg="#FFFFFF", selectcolor="#FFFFFF")
above_radio.grid(row=1, column=0, padx=10, pady=10)

below_radio = tk.Radiobutton(input_frame, text="Below", variable=selected_side, value="Below", 
                             font=("Helvetica", 12), fg="#000000", bg="#FFFFFF", selectcolor="#FFFFFF")
below_radio.grid(row=1, column=1, padx=10, pady=10)

toss_button = tk.Button(input_frame, text="Toss", font=("Helvetica", 12, "bold"), command=perform_toss, 
                        bg="#FF4500", fg="#FFFFFF")
toss_button.grid(row=1, column=2, padx=10, pady=10)

# Dropdown menu for selecting background color theme
theme_var = tk.StringVar(value="Select Theme")
theme_dropdown = tk.OptionMenu(root, theme_var, "Golden Grey", "Pink and Blue", "Yellow", "White", "Grey", 
                               command=change_background)
theme_dropdown.pack(pady=10)

# Result Label with Themed Colors
result_label = tk.Label(root, text="", font=("Helvetica", 14), fg="#000000", bg="#FFFFFF", justify="center")
result_label.pack(pady=10)

# Random Number Label with Dynamic Colors
random_number_label = tk.Label(root, text="", font=("Helvetica", 24, "bold"), bg="#FFFFFF", justify="center")
random_number_label.pack(pady=10)

# Other Info Label with Themed Colors
other_info_label = tk.Label(root, text="", font=("Helvetica", 12), fg="#000000", bg="#FFFFFF", justify="left")
other_info_label.pack(pady=10)

# Start the main loop
root.mainloop()
